# Copia este archivo a ".env" y completa tus datos reales.
# NUNCA subas el archivo ".env" real a internet ni lo compartas.

# Claves de Stripe (https://dashboard.stripe.com/apikeys)
# Mientras uses las claves que empiezan con "sk_test_" / "pk_test_",
# los pagos son de PRUEBA (no se cobra dinero real).
# Cuando actives tu cuenta de Stripe y uses las claves "sk_live_" / "pk_live_",
# los pagos con tarjeta (Visa, Mastercard, Amex, etc.) serán reales.
STRIPE_SECRET_KEY=sk_test_reemplaza_esto
STRIPE_PUBLISHABLE_KEY=pk_test_reemplaza_esto

# Puerto donde corre el servidor
PORT=3000

# URL pública donde correrá la app (para los links de éxito/cancelación de Stripe).
# En local puede quedar como está. Cuando publiques la app en internet, cámbiala
# por tu dominio real, por ejemplo: https://pedidos.quinoa.com
APP_BASE_URL=http://localhost:3000

# Nombre del restaurante (se muestra en la app)
BUSINESS_NAME=Quinoa

# --- Solo para producción en Vercel, no hace falta nada aquí en local ---
# Cuando conectes una base de datos Redis (Upstash) desde el dashboard de
# Vercel (Storage → Marketplace → Upstash), Vercel agrega automáticamente
# variables como UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN al
# proyecto en Vercel. No necesitas copiarlas aquí.
